{
  "$schema": "https://apps.fynncloud.ch/schemas/app-manifest-v1.json",
  "id": "my-app",
  "name": "My App Name",
  "version": "1.0.0",
  "description": "A concise one-line description of what your app does",
  "author": "Your Name / Organization",
  "category": "productivity",
  "icon": "heroicons:cube-solid",
  "ui": {
    "launcher": true,
    "sidebar": [
      {
        "id": "my-app-dashboard",
        "label": "Dashboard",
        "icon": "heroicons:squares-2x2-solid",
        "position": "top_nav",
        "target": "/"
      }
    ]
  },
  "database": false,
  "storage": false,
  "permissions": [
    "files:all:read"
  ],
  "compatibility": {
    "api_version": ">=0.1.0 <0.2.0"
  },
  "deploy": {
    "image": "ghcr.io/yourorg/my-app:1.0.0",
    "port": 8080,
    "architectures": [
      "amd64",
      "arm64"
    ],
    "resources": {
      "memory": "256MB",
      "cpu": 0.5
    }
  }
}
