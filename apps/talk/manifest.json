{
  "$schema": "https://apps.fynncloud.ch/schemas/app-manifest-v1.json",
  "id": "talk",
  "name": "Talk",
  "version": "1.0.11",
  "description": "Real-time team messaging, 1:1 & group conversations, file sharing, and WebRTC audio/video calls with screen sharing",
  "author": "FynnCloud",
  "icon": "heroicons:chat-bubble-left-right-solid",
  "category": "collaboration",
  "ui": {
    "launcher": true,
    "entrypoint": "/",
    "background": false,
    "sidebar_mode": "rail"
  },
  "database": true,
  "storage": true,
  "compatibility": {
    "fynncloud": ">=1.0.0 <2.0.0",
    "apps": [
      {
        "id": "calendar",
        "version": ">=1.0.0 <2.0.0",
        "optional": true,
        "access": "write"
      }
    ]
  },
  "permissions": [
    "user:read",
    "presence:write",
    "groups:read",
    "files:all:read",
    "files:all:write",
    "users:events",
    "notifications:send",
    "realtime:push",
    "media:capture",
    "rtc:rooms"
  ],
  "oauth": {
    "redirect_uris": [
      "fynncloud-talk://auth"
    ]
  },
  "events": [
    "user.created",
    "user.updated",
    "user.deleted",
    "group.updated",
    "group.deleted",
    "group.member_added",
    "group.member_removed"
  ],
  "hooks": {
    "file_actions": [
      {
        "id": "share-in-talk",
        "label": "Share in Talk",
        "extensions": [
          "*"
        ],
        "icon": "heroicons:chat-bubble-left-right-solid",
        "mode": "navigate",
        "role": "action",
        "target": "/share"
      }
    ]
  },
  "deploy": {
    "image": "ghcr.io/fynncloudproject/app-talk:1.0.11",
    "port": 8080,
    "architectures": [
      "amd64",
      "arm64"
    ],
    "resources": {
      "memory": "256MB",
      "cpu": 0.5
    },
    "healthcheck": {
      "path": "/health",
      "interval_seconds": 30,
      "timeout_seconds": 5
    }
  }
}

