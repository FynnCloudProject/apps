{
  "$schema": "https://apps.fynncloud.ch/schemas/app-manifest-v1.json",
  "id": "calendar",
  "name": "Calendar",
  "version": "1.0.0",
  "description": "Manage appointments, team schedules, and personal events",
  "author": "FynnCloud",
  "icon": "heroicons:calendar-days-solid",
  "category": "productivity",
  "ui": {
    "launcher": true,
    "sidebar": [
      {
        "id": "calendar-today",
        "label": "Today's Schedule",
        "icon": "heroicons:calendar-days-solid",
        "position": "bottom_nav",
        "target": "/today"
      }
    ]
  },
  "database": true,
  "storage": true,
  "compatibility": {
    "api_version": ">=0.1.0 <0.2.0"
  },
  "permissions": [
    "files:all:read",
    "notifications:send"
  ],
  "events": [
    "user.created",
    "file.created"
  ],
  "hooks": {
    "file_actions": [
      {
        "id": "import-ics",
        "label": "Import to Calendar",
        "extensions": [
          "ics",
          "ical"
        ],
        "icon": "heroicons:calendar-days-solid",
        "target": "/import"
      }
    ]
  },
  "deploy": {
    "image": "ghcr.io/fynncloudproject/app-calendar:1.0.0",
    "port": 8080,
    "architectures": [
      "amd64",
      "arm64"
    ],
    "resources": {
      "memory": "256MB",
      "cpu": 0.5
    }
  }
}
