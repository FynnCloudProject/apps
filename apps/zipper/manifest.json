{
  "$schema": "https://apps.fynncloud.ch/schemas/app-manifest-v1.json",
  "id": "zipper",
  "name": "Zipper",
  "version": "1.0.0",
  "description": "Create standard ZIP archives from single or multiple files directly from your context menu",
  "author": "FynnCloud",
  "icon": "lucide:file-archive",
  "category": "utilities",
  "ui": false,
  "compatibility": {
    "api_version": ">=0.1.0 <0.2.0"
  },
  "permissions": [
    "files:all:read",
    "files:all:write"
  ],
  "hooks": {
    "file_actions": [
      {
        "id": "zip-files",
        "label": "Compress to ZIP",
        "extensions": [
          "*"
        ],
        "icon": "lucide:file-archive",
        "mode": "background",
        "target": "/api/zip"
      }
    ]
  },
  "deploy": {
    "image": "ghcr.io/fynncloudproject/app-zipper:1.0.0",
    "port": 8080,
    "architectures": [
      "amd64",
      "arm64"
    ],
    "resources": {
      "memory": "128MB",
      "cpu": 0.5
    }
  }
}
