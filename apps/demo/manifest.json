{
  "$schema": "https://apps.fynncloud.ch/schemas/app-manifest-v1.json",
  "id": "demo",
  "name": "Demo App",
  "version": "1.0.0",
  "description": "Interactive developer studio showcasing App Bridge RPC, PostgreSQL schema isolation, webhooks, context menu hooks, and persistent volumes",
  "author": "FynnCloud",
  "icon": "heroicons:code-bracket-square-solid",
  "category": "developer",
  "ui": {
    "launcher": true,
    "sidebar": [
      {
        "id": "demo-dashboard",
        "label": "Demo Dashboard",
        "icon": "heroicons:squares-2x2-solid",
        "position": "top_nav",
        "target": "/"
      },
      {
        "id": "demo-events",
        "label": "Live Events",
        "icon": "heroicons:bolt-solid",
        "position": "top_nav",
        "target": "/events"
      },
      {
        "id": "demo-storage",
        "label": "Storage Explorer",
        "icon": "heroicons:archive-box-solid",
        "position": "top_nav",
        "target": "/storage"
      }
    ]
  },
  "database": true,
  "storage": true,
  "compatibility": {
    "api_version": ">=0.1.0 <0.2.0"
  },
  "permissions": [
    "files:all:read",
    "files:all:write",
    "user:read",
    "notifications:send"
  ],
  "events": [
    "file.created",
    "file.updated",
    "file.deleted",
    "user.created"
  ],
  "hooks": {
    "file_actions": [
      {
        "id": "inspect-in-demo",
        "label": "Inspect with Demo",
        "extensions": [
          "*"
        ],
        "icon": "heroicons:document-magnifying-glass-solid",
        "mode": "navigate",
        "target": "/inspect"
      }
    ]
  },
  "deploy": {
    "image": "ghcr.io/fynncloudproject/app-demo:1.0.0",
    "port": 8080,
    "architectures": [
      "amd64",
      "arm64"
    ],
    "resources": {
      "memory": "256MB",
      "cpu": 0.5
    },
    "healthcheck": {
      "path": "/health",
      "interval_seconds": 30,
      "timeout_seconds": 5
    }
  }
}
